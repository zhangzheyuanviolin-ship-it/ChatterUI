+
+        size_t offset = 0;
+        while (offset < input.size()) {
+            const size_t expectedBytes = unicode_len_utf8(input[offset]);
+            if (expectedBytes == 0 || offset + expectedBytes > input.size()) {
+                output.append(unicode_cpt_to_utf8(0xFFFD));
+                offset += 1;
+                continue;
+            }
+
+            try {
+                const std::string utf8Chunk(input.substr(offset, expectedBytes));
+                size_t parseOffset = 0;
+                unicode_cpt_from_utf8(utf8Chunk, parseOffset);
+                if (parseOffset == expectedBytes) {
+                    output.append(utf8Chunk);
